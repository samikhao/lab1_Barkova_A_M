DATABASE_URL = "__PUT_YOUR_DB_URL__"  # ссылка на базу данных
JWT_SECRET = "__SET_RANDOM_SECRET__"  # длинная случайная строка для подписи JWT-токенов
GITHUB_CLIENT_ID = "__PUT_YOUR_GITHUB_CLIENT_ID__"  # Client ID из настроек GitHub OAuth App
GITHUB_CLIENT_SECRET = "__PUT_YOUR_GITHUB_CLIENT_SECRET__"  # Client Secret из GitHub OAuth App
GITHUB_REDIRECT_URL = "http://localhost:8000/api/v1/auth/github/callback"  # URL для callback
REDIS_URL=redis://redis:6379/0  # Redis

# observability
LOG_FILE=/app/logs/app.jsonl
METRICS_JSONL=/app/metrics/metrics.jsonl
METRICS_DUMP_INTERVAL_SEC=10

# Hawk
HAWK_TOKEN=REPLACE_ME
